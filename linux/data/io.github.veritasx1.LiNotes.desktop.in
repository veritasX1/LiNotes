[Desktop Entry]
Type=Application
Name=LiNotes
Comment=Notizen, Listen und Aufgaben auf deinem eigenen Server
Exec=@EXEC@
Icon=io.github.veritasx1.LiNotes
Terminal=false
Categories=Office;Utility;GTK;
Keywords=Notizen;Notes;Einkaufsliste;Kanban;Aufgaben;
StartupNotify=true
StartupWMClass=io.github.veritasx1.LiNotes
Actions=new-note;

[Desktop Action new-note]
Name=Neue Notiz
Exec=@EXEC@ --neue-notiz
